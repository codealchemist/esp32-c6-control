        "payload": {
          "taskId": "lights"
        },
        "qos": 1,
        "expectsResult": true,
        "default": false,
        "on": {
          "tuyaScene": "Turn On"
        },
        "off": {
          "tuyaScene": "Turn Off"
        }
      }
    },
    {
      "id": "volume",
      "type": "action",
      "label": "Volume",
      "icon": "icon_volume",
      "action": "volume"
    },
    {
      "id": "messages",
      "type": "folder",
      "label": "Messages",
      "icon": "icon_mail",
      "binding": "message_inbox",
      "children": []
    },
    {
      "id": "scenes",
      "type": "folder",
      "label": "Scenes",
      "icon": "icon_scenes",
      "children": [
        {
          "id": "scene-night",
          "type": "task",
          "label": "Night",
